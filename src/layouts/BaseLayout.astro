---
import BaseHead from "@/components/BaseHead.astro";
import Navigation from "@/components/global/Navigation.astro"
import Footer from "@/components/global/Footer.astro"
import '@fortawesome/fontawesome-free/css/all.min.css';
import AppSidebar from "@/components/global/Sidebar.astro";
---

<html lang="en" class="scroll-smooth selection:bg-black selection:text-white">
  <head>
    <BaseHead />
  </head>
  <body class="bg-background mx-auto 2xl:max-w-screen-xl relative h-screen overflow-hidden">
    <div class="flex h-full">
      <aside class="hidden md:flex lg:flex lg:flex-col w-[380px] shrink-0 h-full touch-pan-y overflow-x-hidden overflow-y-auto overscroll-contain border-r border-zinc-200 bg-zinc-50">
        <AppSidebar />
      </aside>

      <div class="min-w-0 flex-1 h-full overflow-y-auto relative">
        <div class="absolute top-0 left-0 right-0 z-50 md:hidden">
        <Navigation/>
        </div>
        <main><slot /></main>
        <Footer/>
      </div>
    </div>
  </body>
</html>
