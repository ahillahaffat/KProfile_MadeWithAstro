---
const education = [
  {
    school: "Universitas Pembangunan Nasional \"Veteran\" Jawa Timur",
    period: "August 2021 - June 2025",
    degree: "Bachelor of Informatics, Faculty of Computer Science",
    gpa: "3.85 / 4.00",
    link: { label: "Transcript", href: "#" },
  },
];
---

<section class="mb-6">
  <h2 class="text-sm font-bold uppercase border-b border-zinc-900 mb-2 pb-1">Education</h2>
  {education.map((edu) => (
    <div class="mb-1">
      <div class="flex justify-between text-sm font-bold">
        <span>{edu.school}</span>
        <span class="italic font-normal">{edu.period}</span>
      </div>
      <p class="text-sm italic">
        {edu.degree} | GPA: {edu.gpa} [<a href={edu.link.href} class="underline text-blue-700 not-italic">{edu.link.label}</a>]
      </p>
    </div>
  ))}
</section>