---
const research = {
  role: "Independent Security Researcher",
  period: "July 2026",
  points: [
    "Discovered and responsibly disclosed two critical vulnerability chains on Jombang Regency Government systems, achieving CVSS v3.1 scores of 9.8 and 9.1 (CRITICAL), collectively impacting 252,315+ citizen PII records across multiple vulnerability classes including source code exposure, SQL injection, broken access control, and credential exposure. Coordinated responsible disclosure with CSIRT Kabupaten Jombang and BSSN.",
  ],
  link: { label: "Certificate", href: "#" },
};
---

<section class="mb-6">
  <h2 class="text-sm font-bold uppercase border-b border-zinc-900 mb-2 pb-1">Security Research</h2>
  <div class="flex justify-between text-sm font-bold">
    <span>{research.role}</span>
    <span class="italic font-normal">{research.period}</span>
  </div>
  <ul class="list-disc list-outside pl-5 text-sm text-justify space-y-1">
    {research.points.map((point, i) => (
      <li>
        {point}
        {i === research.points.length - 1 && (
          <> [<a href={research.link.href} class="underline text-blue-700 italic">{research.link.label}</a>]</>
        )}
      </li>
    ))}
  </ul>
</section>