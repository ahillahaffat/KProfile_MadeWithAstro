---
import { profileImage } from "@/config/profile-image";
---

<section class="relative overflow-hidden">
  <svg
    class="absolute inset-0 w-full h-full opacity-10"
    viewBox="0 0 1340 241"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="..." fill="black" />
  </svg>

  <div
  class="relative z-10 flex flex-col md:flex-row justify-between items-center gap-8 px-4 md:px-12 pt-24 md:pt-10 pb-8 md:pb-10 max-w-6xl mx-auto"
>
    <!-- IMAGE -->
    <div class="flex-1">
      <div class="w-full" style="aspect-ratio: 4 / 3;">
        <img
          class="rounded-lg shadow-lg w-full h-full object-cover"
          src={profileImage.nonformal.src}
          alt={profileImage.nonformal.alt}
        />
      </div>
    </div>

    <!-- CONTENT -->
    <div class="flex-1">
      <h2
        class="text-3xl md:text-5xl tracking-tighter font-normal text-black leading-tight"
      >
        Hi Gais &amp; Welcome To Kammala Blog
      </h2>

      <ul
        class="grid grid-cols-1 lg:grid-cols-2 text-base text-zinc-500 max-w-xl gap-4 group h-full mt-6 md:mt-12"
      >
        <li>
          <p>
            This site contains information about me, my writings, opinions,
            and mostly serves as personal documentation for when I am learning
            or sharing something.
          </p>
        </li>

        <li>
          <p>
            I am a passionate and meticulous computer science student with a
            strong dedication to software development.
          </p>
        </li>

      <li class="col-span-full text-sm mt-6 md:mt-5">
        <div class="flex flex-wrap items-center gap-3">
          <!-- VIEW CV -->
          <a
            href="/cv"
            class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-gray-800 via-gray-900 to-black text-white font-semibold text-sm rounded-full shadow hover:bg-gradient-to-br hover:from-gray-700 hover:via-gray-800 hover:to-black transition duration-300 ease-in-out"
          >
            <!-- <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 mr-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            > -->
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"
              />
            </svg>

            View CV
          </a>

          <!-- DOWNLOAD CV -->
          <a
            href="/files/cv_ahillakammala.pdf"
            download
            class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-gray-800 via-gray-900 to-black text-white font-semibold text-sm rounded-full shadow hover:bg-gradient-to-br hover:from-gray-700 hover:via-gray-800 hover:to-black transition duration-300 ease-in-out"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 mr-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"
              />
            </svg>

            Download CV
          </a>
        </div>
      </li>
      </ul>
    </div>
  </div>
</section>