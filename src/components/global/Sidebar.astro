---
import {
  Sidebar,
  SidebarHeader,
  SidebarContent,
  SidebarFooter,
  SidebarGroup,
  SidebarGroupLabel,
  SidebarMenu,
  SidebarMenuItem,
  SidebarMenuButton,
} from "@/components/ui/sidebar";
import { profileImage } from "@/config/profile-image";

const menu = [
  { label: "Experience", href: "#experience" },
  { label: "Project", href: "#work" },
  { label: "Recap", href: "#recap" },
];

const logos = [
  { src: "/logos/logo1.svg", alt: "Client 1" },
  { src: "/logos/disney.svg", alt: "Disney" },
  { src: "/logos/sega.svg", alt: "Sega" },
  { src: "/logos/perch.svg", alt: "Perch" },
];
---

<aside class="hidden lg:flex lg:flex-col w-[380px] shrink-0 h-full overflow-y-auto border-r border-zinc-200 bg-zinc-50">
  <Sidebar collapsible="none" class="w-full h-full flex flex-col justify-between">

    <SidebarHeader class="p-8 pb-0">
      <img
        src={profileImage.src}
        alt={profileImage.alt}
        class="w-14 h-14 rounded-full object-cover mb-6"
      />

      <h1 class="text-3xl font-serif leading-tight mb-4 text-zinc-900">
        Hey! I'm Ahilla.<br />
      </h1>

      <p class="text-zinc-500 text-sm mb-6 leading-relaxed">
        2 years of experience working in government, startups, and smart manufacturing.
      </p>

      <button
        id="copy-email"
        type="button"
        class="bg-black text-white rounded-full px-5 py-2.5 text-sm font-medium hover:bg-zinc-800 transition mb-4"
      >
        Copy my email
      </button>

      <div class="flex items-center gap-2 text-sm text-zinc-600 mb-2">
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
        </span>
        Available for work
      </div>
    </SidebarHeader>

    <!-- CONTENT: nav menu -->
    <SidebarContent class="px-8">
      <SidebarGroup class="p-0">
        <SidebarGroupLabel class="px-0 text-xs uppercase tracking-wide text-zinc-400 mb-2">
          Menu
        </SidebarGroupLabel>

        <SidebarMenu class="gap-1">
          {menu.map((item) => (
            <SidebarMenuItem>
              <SidebarMenuButton
                as="a"
                href={item.href}
                class="text-sm text-zinc-500 hover:text-zinc-900 hover:bg-transparent px-0 h-auto py-1.5 font-normal"
              >
                <span>{item.label}</span>
              </SidebarMenuButton>
            </SidebarMenuItem>
          ))}
        </SidebarMenu>
      </SidebarGroup>
    </SidebarContent>

    <SidebarFooter class="p-8 pt-0">
      <div class="flex flex-wrap gap-2 mb-6">
        {logos.map((logo) => (
          <div class="w-10 h-10 rounded-lg bg-white border border-zinc-200 flex items-center justify-center overflow-hidden">
            <img src={logo.src} alt={logo.alt} class="w-6 h-6 object-contain" />
          </div>
        ))}
      </div>

      <div class="flex items-center justify-between text-xs text-zinc-500 border-t border-zinc-200 pt-4">
        <span>© {new Date().getFullYear()}</span>
        <a href="https://linkedin.com" target="_blank" class="hover:text-black transition">
          <i class="fa-brands fa-linkedin"></i>
        </a>
        <span>hello@ahillahaffat.com</span>
      </div>
    </SidebarFooter>

  </Sidebar>
</aside>

<script>
  const btn = document.getElementById("copy-email");
  btn?.addEventListener("click", () => {
    navigator.clipboard.writeText("hello@ahillahaffat.com");
    const original = btn.textContent;
    btn.textContent = "Copied!";
    setTimeout(() => (btn.textContent = original), 2000);
  });